# Interactive zsh. ~/.zshenv has already loaded the portable layer (and, on a
# Mac, the macOS one), so this file adds the interactive half: the zsh layer,
# then the integrations that have to wrap it.
shell_dir=${XDG_CONFIG_HOME:-$HOME/.config}/shell

[[ -r $shell_dir/zsh.zsh ]] && source "$shell_dir/zsh.zsh"

# Last: the prompt and the line-editor widgets wrap what the zsh layer loaded.
command -v shell_tool_integrations >/dev/null && shell_tool_integrations

unset shell_dir
